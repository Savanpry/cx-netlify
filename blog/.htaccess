# Clean URLs for the public blog.
#   mydomain.com/blog        -> index.php   (listing + pagination + category filter)
#   mydomain.com/blog/SLUG   -> blog.php?slug=SLUG   (single blog)

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteBase /blog/
    
    RewriteRule ^blogsitemap\.xml$ blogsitemap.php [L]

    # Don't rewrite requests that map to a real file or directory
    # (lets index.php, blog.php, images, css, etc. load directly).
    #RewriteCond %{REQUEST_FILENAME} -f [OR]
    #RewriteCond %{REQUEST_FILENAME} -d
    #RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]


RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^([A-Za-z0-9_-]+)/?$ $1/index.html [L]


    # If /slug.html exists, serve it internally
    RewriteCond %{DOCUMENT_ROOT}/blog/$1.html -f
    RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.html [L]

    # /blog/SLUG  ->  blog.php?slug=SLUG   (QSA keeps any extra query string)
    RewriteRule ^([A-Za-z0-9_-]+)/?$ blog.php?slug=$1 [L,QSA]


    # Anything else (multi-segment or odd characters) never maps to a blog.
    # Hand it to blog.php with no slug so it issues the same 301 to the listing
    # (done in PHP so the redirect target works whatever folder this lives in).
    RewriteRule ^.+$ blog.php [L]
    
</IfModule>

# /blog and /blog/ load the listing.
DirectoryIndex index.php
